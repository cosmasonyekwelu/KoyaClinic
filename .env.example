# Database connection string (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Server Port
PORT=3000

# Secret API Key for Level 2+ X-API-Key header authentication
API_KEY="your-secret-api-key-here"

# Environment (development, test, production)
NODE_ENV="development"

# Optional: Comma-separated list of allowed CORS origins
# ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional: Remote backend API URL for frontend proxy (defaults to local same-origin if omitted)
# DEPLOYED_API_URL="https://your-deployed-service.onrender.com"
