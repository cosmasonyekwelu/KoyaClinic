# Database connection string (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Server Port
PORT=3000

# Secret API Key for Level 2+ X-API-Key header authentication
API_KEY="your-secret-api-key-here"

# Environment (development, test, production)
NODE_ENV="development"
